# 本地模型服务：ollama（默认），或 openai（LM Studio / llama.cpp server / vLLM 等 OpenAI 兼容服务）
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=

# 默认模型（识别图片需要支持视觉）；分析题意、解题默认使用同一个模型
VISION_MODEL=qwen3.5:4b-q4_K_M
# TEXT_MODEL=

# 上下文长度；“解题思路”是否开启思考模式
NUM_CTX=16384
SOLVE_THINK=true

# 监听地址：HOST=0.0.0.0 时同一局域网的手机也能访问
PORT=3000
HOST=127.0.0.1
